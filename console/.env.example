# Names only. Never commit values; secrets go in `wrangler secret put`.

# Backend: "mock" (development only; refused in production) or "nyuchi".
# Production defaults to "nyuchi". NOTE: the station endpoints beyond the
# drafted readings call are not built on api.nyuchi.com yet (see README).
STATIONS_BACKEND=mock

# The Nyuchi API. The only host this app talks to.
NYUCHI_API_URL=https://api.nyuchi.com

# Host shown in the Wunderground / Ecowitt setup text (path /stations/ingest).
NYUCHI_INGEST_HOST=weather-ingest.nyuchi.com

# WorkOS AuthKit (the shared Nyuchi identity). Register
# https://weatherstations.nyuchi.com/callback as a redirect URI.
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
WORKOS_COOKIE_PASSWORD=
WORKOS_REDIRECT_URI=
