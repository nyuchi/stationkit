# Names only. Never commit values; secrets go in `wrangler secret put`.

# Backend: "mock" (development only; refused in production) or "nyuchi".
# Production defaults to "nyuchi". The Nyuchi backend needs the console's own
# key (below); without it every station action that acts for a person answers
# "Station registration is not live yet" and makes no call.
STATIONS_BACKEND=mock

# The Nyuchi API. The only host this app talks to.
NYUCHI_API_URL=https://api.nyuchi.com

# Fallback host for the Wunderground / Ecowitt setup text (path
# /stations/ingest), used only where the API names none (a rotated key). At
# registration the API says where a station uploads, and that is shown.
NYUCHI_INGEST_HOST=weather-ingest.nyuchi.com

# The console's own internal key for the Nyuchi API (scopes: identity,
# stations), minted by the owner. Worker secrets (`wrangler secret put`), never
# committed, both or neither. Names only here.
NYUCHI_CONSOLE_CLIENT_ID=
NYUCHI_CONSOLE_CLIENT_SECRET=

# WorkOS AuthKit, Nyuchi Console app. All read at RUNTIME from the Worker env.
# Public vars (set in wrangler.jsonc):
WORKOS_CLIENT_ID=client_01KQBBSMQTSMTBN7HEC9KQBJC0
WORKOS_REDIRECT_URI=https://weatherstations.nyuchi.com/callback
# The API key is NOT an env var in production: it is the Cloudflare Secrets
# Store secret CONSOLE_WORKOS_API_KEY, bound under the same name
# (wrangler.jsonc secrets_store_secrets). For `npm run dev:workos` only, a
# plain value in .dev.vars (never committed) is accepted under that name:
CONSOLE_WORKOS_API_KEY=
# A separate Worker secret (`wrangler secret put`), 32+ characters, kept apart
# from the Secrets Store entry above and never committed:
WORKOS_COOKIE_PASSWORD=
