{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stationkit-console",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
  },
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  // OWNER ACTION: replace store_id with the Cloudflare Secrets Store id that
  // holds the secret CONSOLE_WORKOS_API_KEY (the WorkOS API key for the Nyuchi
  // Console app). The placeholder is not a real id; a deploy with it fails.
  // WORKOS_COOKIE_PASSWORD is a separate Worker secret: `wrangler secret put`.
  "secrets_store_secrets": [
    {
      "binding": "CONSOLE_WORKOS_API_KEY",
      "store_id": "REPLACE_WITH_SECRETS_STORE_ID",
      "secret_name": "CONSOLE_WORKOS_API_KEY",
    },
  ],
  // OWNER ACTION: the console's own key for the Nyuchi API (an internal key with
  // the scopes identity and stations, minted by the owner) is two plain Worker
  // secrets: `wrangler secret put NYUCHI_CONSOLE_CLIENT_ID` and
  // `wrangler secret put NYUCHI_CONSOLE_CLIENT_SECRET`. Both or neither; without
  // them the console answers "Station registration is not live yet" and makes
  // no call that acts for a person. Names only here, never a value.
  "vars": {
    "WORKOS_CLIENT_ID": "client_01KQBBSMQTSMTBN7HEC9KQBJC0",
    "WORKOS_REDIRECT_URI": "https://weatherstations.nyuchi.com/callback",
    "NYUCHI_API_URL": "https://api.nyuchi.com",
    // Only the fallback for the setup text: registration shows the host the API names.
    "NYUCHI_INGEST_HOST": "weather-ingest.nyuchi.com",
  },
}
