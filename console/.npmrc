# npm 10 crashes resolving the optional "react" peer of @workos/authkit-astro
# ("Cannot read properties of null (reading edgesOut)"). The console has no
# React, so peers are not auto-installed. Remove once the upstream peer
# metadata resolves cleanly.
legacy-peer-deps=true
# Do not resolve package versions published in the last 7 days.
min-release-age=7
